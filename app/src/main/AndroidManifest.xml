<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Alarm Scheduling -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Network for weather API -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 17+: required for LAN access to Philips Hue bridges and
         local webhook endpoints (Tasker HTTP server, Home Assistant). The app
         still compiles against SDK 36, so suppress the API-37 permission
         warning until the targetSdk 37 migration lands. -->
    <uses-permission
        android:name="android.permission.ACCESS_LOCAL_NETWORK"
        tools:ignore="UnknownPermission"
        tools:targetApi="37" />

    <!-- Calendar for My Day dashboard -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />

    <!-- Location for weather (coarse is sufficient) -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Notifications & Lock Screen -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <!-- Foreground Service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- Audio & Hardware -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Battery Optimization Exemption (legitimate for alarm apps) -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Custom Ringtone Access -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- v1.7.0: Required only on API ≤28 to write downloaded YouTube audio
         into MediaStore.Audio (Alarms folder). API 29+ uses scoped storage,
         which doesn't need this permission. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- NFC for dismiss challenge -->
    <uses-permission android:name="android.permission.NFC" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />

    <!-- Step counter / activity recognition for walk-steps challenge and smart alarm -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-feature android:name="android.hardware.sensor.stepcounter" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.accelerometer" android:required="false" />

    <!-- Camera for barcode scan and photo match challenges -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Audio for sonar sleep tracking (F17) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Smart alarm foreground service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Sonar sleep tracking microphone service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!-- v1.2.0: Guardian Angel — CALL_PHONE is optional and falls back to
         ACTION_DIAL when missing. SEND_SMS is declared only by the F-Droid
         flavor; the Play flavor opens a prefilled SMS composer instead. -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <!-- v1.2.0: Wi-Fi dismiss challenge needs to read the connected SSID -->
    <!-- ACCESS_FINE_LOCATION is required on Android 12+ (API 31+) for
         WifiManager.connectionInfo to return a real SSID instead of <unknown ssid> -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Manufacturer Battery Killer Detection + Spotify ringtone visibility (Android 11+) -->
    <queries>
        <package android:name="com.samsung.android.lool" />
        <package android:name="com.miui.securitycenter" />
        <package android:name="com.huawei.systemmanager" />
        <package android:name="com.oneplus.security" />
        <!-- F14: Spotify must be queryable so resolveActivity()/setPackage() works
             on Android 11+ (without this, the Spotify ringtone path silently
             falls through to the default ringtone even when Spotify is installed). -->
        <package android:name="com.spotify.music" />
    </queries>

    <application
        android:name=".AlarmClockApp"
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:backupAgent=".RestoreAlarmAgent"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:restoreAnyVersion="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AlarmClockXtreme"
        tools:targetApi="36">

        <!-- Main Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.AlarmClockXtreme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
            <!-- Launcher shortcut deep links -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="acx" android:host="navigate" />
            </intent-filter>
            <!-- Allows the system clock affordance ("upcoming alarm" tap) and other
                 apps (e.g., Google Assistant) to open the alarm list directly. -->
            <intent-filter>
                <action android:name="android.intent.action.SHOW_ALARMS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Voice assistant / Gemini: create an alarm via SET_ALARM -->
            <intent-filter>
                <action android:name="android.intent.action.SET_ALARM" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.DISMISS_ALARM" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SNOOZE_ALARM" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SET_TIMER" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- v1.5.x: Import a single shared alarm without importing a full backup. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="alarm"
                    android:scheme="acx" />
            </intent-filter>
        </activity>

        <!-- Full-Screen Alarm Firing Activity -->
        <activity
            android:name=".ui.alarmfiring.AlarmFiringActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:showOnLockScreen="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:taskAffinity=""
            android:theme="@style/Theme.AlarmClockXtreme" />

        <activity
            android:name=".ui.onboarding.OnboardingTestAlarmActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:showOnLockScreen="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/Theme.AlarmClockXtreme" />

        <!-- Alarm Receiver -->
        <receiver
            android:name=".receiver.AlarmReceiver"
            android:exported="false" />

        <receiver
            android:name=".ui.onboarding.OnboardingTestAlarmReceiver"
            android:exported="false" />

        <!-- Minimal Direct Boot fallback alarm path before first unlock. -->
        <receiver
            android:name=".directboot.DirectBootAlarmReceiver"
            android:directBootAware="true"
            android:exported="false" />

        <!-- Boot Receiver - Reschedule alarms after reboot -->
        <receiver
            android:name=".receiver.BootReceiver"
            android:directBootAware="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.DATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Exact alarm permission recovery - reschedule after user grants access -->
        <receiver
            android:name=".receiver.ExactAlarmPermissionReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Snooze Receiver -->
        <receiver
            android:name=".receiver.SnoozeReceiver"
            android:exported="false" />

        <!-- Dismiss Receiver (from notification actions) -->
        <receiver
            android:name=".receiver.DismissReceiver"
            android:exported="false" />

        <!-- Skip Next Receiver (from persistent next-alarm notification) -->
        <receiver
            android:name=".receiver.SkipNextReceiver"
            android:exported="false" />

        <!-- Bedtime Reminder -->
        <receiver
            android:name=".receiver.BedtimeReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.sysadmindoc.alarmclock.BEDTIME_REMINDER" />
                <action android:name="com.sysadmindoc.alarmclock.BEDTIME_COUNTDOWN_UPDATE" />
            </intent-filter>
        </receiver>

        <!-- Timer expiry survives app process death via AlarmManager. -->
        <receiver
            android:name=".ui.timer.TimerExpiryReceiver"
            android:exported="false" />

        <!-- Alarm Foreground Service -->
        <service
            android:name=".service.AlarmService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <service
            android:name=".directboot.DirectBootAlarmService"
            android:directBootAware="true"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <activity
            android:name=".directboot.DirectBootAlarmActivity"
            android:directBootAware="true"
            android:exported="false"
            android:excludeFromRecents="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:taskAffinity=""
            android:theme="@style/Theme.AlarmClockXtreme" />

        <!-- F6: Smart Alarm motion-monitoring service -->
        <service
            android:name=".service.SmartAlarmService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- F17: Sonar sleep tracking service (experimental) -->
        <service
            android:name=".service.SonarSleepService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- v1.10.5: App-owned bedtime DND rule. The system binds this
             provider to evaluate the condition URI created by the Bedtime tab. -->
        <service
            android:name=".service.BedtimeZenRuleService"
            android:exported="true"
            android:icon="@drawable/ic_alarm"
            android:label="@string/bedtime_dnd_rule_name"
            android:permission="android.permission.BIND_CONDITION_PROVIDER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.ConditionProviderService" />
            </intent-filter>
            <meta-data
                android:name="android.service.zen.automatic.ruleType"
                android:value="@string/bedtime_dnd_rule_type" />
            <meta-data
                android:name="android.service.zen.automatic.ruleInstanceLimit"
                android:value="1" />
        </service>

        <!-- v1.11.0: Wear OS tile action bridge. Play flavor handles incoming
             Data Layer messages; F-Droid ships a same-name no-op service so
             Play Services stays out of the F-Droid dependency graph. -->
        <service
            android:name=".wear.WearAlarmActionListenerService"
            android:enabled="${wearActionBridgeEnabled}"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:host="*"
                    android:pathPrefix="/alarmclockxtreme/action"
                    android:scheme="wear" />
            </intent-filter>
        </service>

        <!-- F3: Morning Briefing overlay (shown on lock screen after dismissal) -->
        <activity
            android:name=".ui.alarmfiring.MorningBriefingActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:taskAffinity=""
            android:theme="@style/Theme.AlarmClockXtreme" />

        <!-- F5: Wake Confirmation activity (shown on lock screen) -->
        <activity
            android:name=".ui.alarmfiring.WakeConfirmActivity"
            android:exported="false"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/Theme.AlarmClockXtreme" />

        <!-- WorkManager: disable default initializer so HiltWorkerFactory can be used -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Home Screen Widget -->
        <receiver
            android:name=".widget.NextAlarmWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/next_alarm_widget_info" />
        </receiver>

        <!-- v1.2.0: Night Clock / Bedside Mode -->
        <activity
            android:name=".ui.nightclock.NightClockActivity"
            android:exported="false"
            android:theme="@style/Theme.AlarmClockXtreme" />

        <!-- v1.4.0: Quick Settings tile — "Skip next alarm" (tap to skip from shade) -->
        <service
            android:name=".service.SkipNextAlarmTileService"
            android:exported="true"
            android:icon="@drawable/ic_alarm"
            android:label="@string/qs_tile_skip_next_alarm"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- v1.4.0/v1.15.20: Repeat-missed-alarm handler — fires on screen
             unlock or charge disconnect if the last alarm auto-silenced within
             the configured window. -->
        <receiver
            android:name=".receiver.MissedAlarmUnlockReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.USER_PRESENT" />
                <action android:name="android.intent.action.ACTION_POWER_DISCONNECTED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
