<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- SurfaceDark, matching what Compose paints. The launch used to step
         through Theme.Material's own grey and then #0D1B2A before landing on
         the app's background, which read as a flash. windowBackground is what
         the API 31+ splash paints when no splash background is set, so one
         colour here covers both. -->
    <style name="Theme.AlarmClockXtreme" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#070B11</item>
        <item name="android:colorBackground">#070B11</item>
    </style>

    <style name="Theme.AlarmClockXtreme.IntentProxy" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
