<?xml version="1.0" encoding="utf-8"?>
<!--
  Cloud backup / device-transfer rules. The previous configuration only
  preserved the Room database and SharedPreferences, which silently dropped:
    - DataStore preferences (alarm_settings.preferences_pb) — vacation mode,
      holiday config, Philips Hue creds, accent color, every v1.2.0 setting
    - Photo-match reference photos saved to filesDir
  After restore the user would have lost most of their configuration despite
  the system reporting a "successful" backup.

  Crash logs are intentionally not included (they're large, transient, and
  contain device-fingerprint detail that's irrelevant on the new device).
  Android lint requires <exclude> entries to live underneath an <include>
  path; since crash_logs is not in any include above, we simply leave it
  out entirely rather than listing a redundant exclude.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="alarm_clock.db" />
        <include domain="sharedpref" path="." />
        <!--
          DataStore preferences are EXCLUDED from cloud backup because the
          settings proto contains webhook URLs, Hue API keys, guardian phone
          numbers, and custom feed URLs. These should not traverse Google's
          cloud backup pipeline. The Room alarm database (schedules, labels,
          challenge configs) is still included. Device-transfer includes
          DataStore because that path stays on-device.
        -->
        <!-- Photo-match reference photos used by the F16 challenge -->
        <include domain="file" path="photo_match_" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="alarm_clock.db" />
        <include domain="sharedpref" path="." />
        <include domain="file" path="datastore/" />
        <include domain="file" path="photo_match_" />
    </device-transfer>
</data-extraction-rules>
