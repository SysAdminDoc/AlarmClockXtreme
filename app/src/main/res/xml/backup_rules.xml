<?xml version="1.0" encoding="utf-8"?>
<!--
  Legacy Auto Backup rules for Android 8-11 (API 26-30).

  Android 12+ uses data_extraction_rules.xml (which separates cloud-backup
  from device-transfer). Older devices use this file for BOTH paths and
  cannot distinguish them. DataStore is EXCLUDED because it stores webhook
  URLs, Hue API keys, guardian contacts, custom typing phrases, and custom
  feed URLs — secrets that must not traverse Google's cloud backup pipeline.
  The Room alarm database (schedules, labels, challenge configs),
  SharedPreferences (non-secret runtime state), and photo-match reference
  photos are safe to back up.
-->
<full-backup-content>
    <include domain="database" path="alarm_clock.db" />
    <include domain="sharedpref" path="." />
    <exclude domain="sharedpref" path="bedtime_noise_baseline.xml" />
    <include domain="file" path="photo_match_" />
</full-backup-content>
